generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  phone       String   @unique
  password    String
  fullName    String
  cnic        String?  @unique
  roles       Role[]   @default([TENANT])
  trustScore  Int      @default(50)
  isVerified  Boolean  @default(false)
  isSuspended Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  listings               Listing[]
  landlordProfile        LandlordProfile?
  favorites              Favorite[]
  rentalRequests         RentalRequest[]      @relation("RequestTenant")
  receivedRentalRequests RentalRequest[]      @relation("RequestLandlord")
  notifications          Notification[]
  reports                Report[]
  propertyViews          PropertyView[]
  tenantAgreements       Agreement[]          @relation("TenantAgreements")
  landlordAgreements     Agreement[]          @relation("LandlordAgreements")
  payments               Payment[]
  tenantDisputes         Dispute[]            @relation("TenantDisputes")
  reviews                Review[]
  conversationsAsUser1   Conversation[]       @relation("User1")
  conversationsAsUser2   Conversation[]       @relation("User2")
  sentMessages           Message[]            @relation("Sender")
  verificationTokens     VerificationToken[]
  resetPasswordTokens    ResetPasswordToken[]
}

model LandlordProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String?
  bio         String?
  avatarUrl   String?
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Listing {
  id                String                   @id @default(cuid())
  title             String
  description       String
  rules             String?
  area              String
  city              String
  address           String
  type              PropertyType
  bedrooms          Int
  bathrooms         Int
  unitCount         Int                      @default(1)
  roomCount         Int                      @default(0)
  sqft              Int
  rent              Int
  deposit           Int
  rentalDuration    RentalDuration           @default(MONTHLY)
  availableFrom     DateTime?
  latitude          Float?
  longitude         Float?
  status            ListingStatus            @default(DRAFT)
  publicationStatus ListingPublicationStatus @default(PUBLISHED)
  availability      ListingAvailability      @default(AVAILABLE)
  furnishedStatus   FurnishedStatus          @default(UNFURNISHED)
  fraudScore        Float                    @default(0)
  photos            String[]
  landlordId        String
  landlord          User                     @relation(fields: [landlordId], references: [id])
  locationId        String?
  location          Location?                @relation("ListingLocation", fields: [locationId], references: [id], onDelete: SetNull)
  agreements        Agreement[]
  reviews           Review[]
  images            PropertyImage[]
  amenities         PropertyAmenity[]
  hostelDetails     HostelDetails?
  hostelRooms       HostelRoom[]
  favorites         Favorite[]
  rentalRequests    RentalRequest[]
  reports           Report[]
  propertyViews     PropertyView[]
  conversations     Conversation[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([city])
  @@index([area])
  @@index([type])
  @@index([status])
  @@index([rent])
  @@index([bedrooms])
  @@index([roomCount])
  @@index([landlordId])
  @@index([locationId])
  @@index([latitude, longitude])
}

model Location {
  id        String        @id @default(cuid())
  name      String
  slug      String
  level     LocationLevel
  parentId  String?
  parent    Location?     @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  Location[]    @relation("LocationHierarchy")
  listings  Listing[]     @relation("ListingLocation")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([parentId, slug])
  @@index([level])
  @@index([parentId])
}

model PropertyImage {
  id        String   @id @default(cuid())
  listingId String
  url       String
  publicId  String?
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, sortOrder])
}

model Amenity {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  listings PropertyAmenity[]
}

model PropertyAmenity {
  listingId String
  amenityId String

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([listingId, amenityId])
  @@index([amenityId])
}

model HostelDetails {
  id                  String             @id @default(cuid())
  listingId           String             @unique
  buildingName        String
  genderPolicy        HostelGenderPolicy
  bedCapacity         Int
  availableBeds       Int
  messIncluded        Boolean            @default(false)
  wifiIncluded        Boolean            @default(false)
  laundryIncluded     Boolean            @default(false)
  electricityIncluded Boolean            @default(false)
  securityIncluded    Boolean            @default(false)
  listing             Listing            @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model HostelRoom {
  id            String   @id @default(cuid())
  listingId     String
  roomNumber    String
  capacity      Int
  availableBeds Int
  listing       Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([listingId, roomNumber])
  @@index([listingId])
}

model Favorite {
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@index([listingId])
}

model Agreement {
  id         String          @id @default(cuid())
  listingId  String
  listing    Listing         @relation(fields: [listingId], references: [id])
  tenantId   String
  tenant     User            @relation("TenantAgreements", fields: [tenantId], references: [id])
  landlordId String
  landlord   User            @relation("LandlordAgreements", fields: [landlordId], references: [id])
  rent       Int
  deposit    Int
  startDate  DateTime
  endDate    DateTime
  pdfUrl     String?
  status     AgreementStatus @default(PENDING)
  payments   Payment[]
  disputes   Dispute[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model Payment {
  id            String        @id @default(cuid())
  agreementId   String
  agreement     Agreement     @relation(fields: [agreementId], references: [id])
  tenantId      String
  tenant        User          @relation(fields: [tenantId], references: [id])
  amount        Int
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  transactionId String?
  receiptUrl    String?
  month         DateTime
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Dispute {
  id          String        @id @default(cuid())
  agreementId String
  agreement   Agreement     @relation(fields: [agreementId], references: [id])
  tenantId    String
  tenant      User          @relation("TenantDisputes", fields: [tenantId], references: [id])
  title       String
  description String
  amount      Int?
  status      DisputeStatus @default(OPEN)
  resolution  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([listingId, userId])
  @@index([listingId, createdAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  message   String
  status    String   @default("new")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Conversation {
  id             String   @id @default(cuid())
  participant1Id String
  participant1   User     @relation("User1", fields: [participant1Id], references: [id], onDelete: Cascade)
  participant2Id String
  participant2   User     @relation("User2", fields: [participant2Id], references: [id], onDelete: Cascade)
  listingId      String?
  listing        Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  lastMessageAt  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  messages Message[]

  @@unique([participant1Id, participant2Id, listingId])
  @@index([participant1Id, participant2Id])
  @@index([listingId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  attachmentUrl  String?
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  reports Report[]

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model RentalRequest {
  id         String              @id @default(cuid())
  listingId  String
  tenantId   String
  landlordId String
  message    String?
  status     RentalRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  listing  Listing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  tenant   User    @relation("RequestTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  landlord User    @relation("RequestLandlord", fields: [landlordId], references: [id], onDelete: Cascade)

  @@unique([listingId, tenantId])
  @@index([landlordId, status])
  @@index([tenantId, status])
  @@index([listingId, status])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  listingId  String?
  messageId  String?
  reason     String
  status     ReportStatus @default(OPEN)
  resolution String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  reporter User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  listing  Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)
  message  Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([listingId])
  @@index([messageId])
}

model PropertyView {
  id        String   @id @default(cuid())
  listingId String
  userId    String?
  sessionId String?
  viewedAt  DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([listingId, viewedAt])
  @@index([userId, viewedAt])
  @@index([sessionId, viewedAt])
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
}

model ResetPasswordToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
}

enum Role {
  TENANT
  LANDLORD
  ADMIN
}

enum PropertyType {
  HOUSE
  APARTMENT
  FLAT
  PORTION
  ROOM
  HOSTEL
  STUDIO
  PG
  SHARED_ROOM
}

enum ListingStatus {
  DRAFT
  PENDING
  PUBLISHED
  UNPUBLISHED
  VERIFIED
  FLAGGED
  REMOVED
}

enum ListingPublicationStatus {
  PUBLISHED
  UNPUBLISHED
}

enum ListingAvailability {
  AVAILABLE
  RENTED
}

enum RentalDuration {
  DAILY
  WEEKLY
  MONTHLY
  LONG_TERM
}

enum FurnishedStatus {
  FURNISHED
  SEMI_FURNISHED
  UNFURNISHED
}

enum LocationLevel {
  COUNTRY
  PROVINCE
  CITY
  AREA
  BLOCK_SECTOR
}

enum HostelGenderPolicy {
  MALE
  FEMALE
  MIXED
}

enum AgreementStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentMethod {
  JAZZCASH
  EASYPAISA
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum DisputeStatus {
  OPEN
  MEDIATION
  RESOLVED
  CLOSED
}

enum ContactMessageStatus {
  NEW
  READ
  REPLIED
  RESOLVED
}

enum RentalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

enum NotificationType {
  RENTAL_REQUEST
  REQUEST_STATUS
  NEW_MESSAGE
  PAYMENT
  REVIEW
  SYSTEM
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}
