generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TENANT
  LANDLORD
  AGENT
  HOTEL_MANAGER
  HOSTEL_MANAGER
  PROPERTY_MANAGER
  ADMIN
}

enum UserVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum PropertyType {
  HOUSE
  APARTMENT
  FLAT
  PORTION
  ROOM
  HOSTEL
  HOTEL
  GUEST_HOUSE
  STUDIO
  FARMHOUSE
  PG
  SHARED_ROOM
  OTHER
}

enum ListingMode {
  SHORT_TERM
  LONG_TERM
}

enum ListingStatus {
  DRAFT
  PENDING
  PUBLISHED
  UNPUBLISHED
  REMOVED
  ARCHIVED
}

enum PropertyStatus {
  DRAFT
  PENDING_VERIFICATION
  ACTIVE
  RENTED
  EXPIRED
  REJECTED
  SUSPENDED
}

enum ListingPublicationStatus {
  PUBLISHED
  UNPUBLISHED
}

enum ListingAvailability {
  AVAILABLE
  RENTED
}

enum RentalDuration {
  DAILY
  NIGHTLY
  WEEKLY
  MONTHLY
  LONG_TERM
}

enum FurnishedStatus {
  FURNISHED
  SEMI_FURNISHED
  UNFURNISHED
}

enum BookingStatus {
  PENDING
  PAYMENT_PENDING
  HELD
  CONFIRMED
  CANCELLED
  COMPLETED
  REJECTED
  EXPIRED
}

enum RentalRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

enum AgreementStatus {
  DRAFT
  PENDING
  ACTIVE
  ENDED
  CANCELLED
}

enum PaymentMethod {
  JAZZCASH
  EASYPAISA
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum AvailabilityStatus {
  AVAILABLE
  BLOCKED
  MAINTENANCE
  BOOKED
  HOLD
  UNAVAILABLE
}

enum LocationLevel {
  COUNTRY
  PROVINCE
  CITY
  AREA
  BLOCK_SECTOR
  NEARBY_LANDMARK
}

enum HostelGenderPolicy {
  MALE
  FEMALE
  MIXED
}

enum NotificationType {
  NEW_MESSAGE
  NEW_BOOKING
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  RENTAL_REQUEST
  RENTAL_REQUEST_ACCEPTED
  RENTAL_REQUEST_REJECTED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  NEW_REVIEW
  PROPERTY_APPROVED
  PROPERTY_REJECTED
  SAVED_SEARCH_MATCH
  REPORT_UPDATE
  BOOKING
  MESSAGE
  PAYMENT
  REVIEW
  REPORT
  SYSTEM
  VERIFICATION
}

enum ReportTargetType {
  PROPERTY
  LISTING
  BOOKING
  USER
  MESSAGE
}

enum ReportStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  REJECTED
}

enum ReviewTargetType {
  PROPERTY
  LISTING
  BOOKING
  HOST
  HOTEL
  HOSTEL
}

enum TrustSource {
  VERIFICATION
  REVIEW
  BOOKING
  PAYMENT
  REPORT
  ADMIN
}

enum AdminActionType {
  WARNING
  REMOVE_LISTING
  SUSPEND_USER
  REJECT_LISTING
  RESOLVE_REPORT
  VERIFY_PROPERTY
}

enum ContactMessageStatus {
  NEW
  READ
  REPLIED
  RESOLVED
}

enum DisputeStatus {
  OPEN
  MEDIATION
  RESOLVED
  CLOSED
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  phone       String   @unique
  password    String
  fullName    String
  cnic        String?  @unique
  roles       Role[]   @default([TENANT])
  trustScore  Int      @default(50)
  isVerified  Boolean  @default(false)
  isSuspended Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profile              UserProfile?
  landlordProfile      LandlordProfile?
  agentProfile         AgentProfile?
  verificationRecords  VerificationRecord[]
  properties           Property[]
  managedProperties    PropertyManager[]
  listings             Listing[]
  favorites            Favorite[]
  savedSearches        SavedSearch[]
  reviews              Review[]
  bookings             Booking[]
  propertyViews        PropertyView[]
  notifications        Notification[]
  reports              Report[]
  adminActions         AdminAction[]
  rentalsAsTenant      RentalRequest[]      @relation("RequestTenant")
  rentalsAsLandlord    RentalRequest[]      @relation("RequestLandlord")
  tenantAgreements     Agreement[]          @relation("TenantAgreements")
  landlordAgreements   Agreement[]          @relation("LandlordAgreements")
  payments             Payment[]
  disputes             Dispute[]            @relation("TenantDisputes")
  conversationsAsUser1 Conversation[]       @relation("User1")
  conversationsAsUser2 Conversation[]       @relation("User2")
  sentMessages         Message[]            @relation("Sender")
  verificationTokens   VerificationToken[]
  resetPasswordTokens  ResetPasswordToken[]
  refreshTokens        RefreshToken[]
  trustScores          TrustScore[]
}

model UserProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  bio        String?
  avatarUrl  String?
  city       String?
  country    String?  @default("Pakistan")
  isBusiness Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationRecord {
  id         String                 @id @default(cuid())
  userId     String
  recordType String
  status     UserVerificationStatus @default(PENDING)
  fileUrl    String?
  notes      String?
  createdAt  DateTime               @default(now())
  reviewedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model AgentProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  companyName   String?
  licenseNumber String?
  isVerified    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LandlordProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String?
  bio         String?
  avatarUrl   String?
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Location {
  id        String        @id @default(cuid())
  name      String
  slug      String
  level     LocationLevel
  parentId  String?
  latitude  Float?
  longitude Float?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  parent     Location?  @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children   Location[] @relation("LocationHierarchy")
  properties Property[] @relation("PropertyLocation")
  listings   Listing[]  @relation("ListingLocation")

  @@unique([parentId, slug])
  @@index([level])
  @@index([parentId])
  @@index([latitude, longitude])
}

model Property {
  id              String              @id @default(cuid())
  ownerId         String
  title           String
  description     String?
  propertyType    PropertyType
  rentalMode      RentalDuration      @default(MONTHLY)
  price           Int                 @default(0)
  securityDeposit Int?
  bedrooms        Int                 @default(0)
  bathrooms       Int                 @default(0)
  areaSizeSqft    Int?
  furnishedStatus FurnishedStatus     @default(UNFURNISHED)
  availability    ListingAvailability @default(AVAILABLE)
  rules           String?
  status          PropertyStatus      @default(PENDING_VERIFICATION)
  country         String              @default("Pakistan")
  city            String?
  area            String?
  address         String
  latitude        Float?
  longitude       Float?
  locationId      String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  owner            User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  location         Location?         @relation("PropertyLocation", fields: [locationId], references: [id], onDelete: SetNull)
  managers         PropertyManager[]
  images           PropertyImage[]   @relation("PropertyImageProperty")
  amenities        PropertyAmenity[]
  listings         Listing[]
  favorites        Favorite[]        @relation("FavoriteProperty")
  views            PropertyView[]    @relation("PropertyViewProperty")
  bookings         Booking[]
  rentalRequests   RentalRequest[]
  agreements       Agreement[]
  reviews          Review[]          @relation("ReviewProperty")
  reports          Report[]          @relation("ReportProperty")
  availabilityData Availability[]
  hotel            Hotel?
  hostel           Hostel?
  disputes         Dispute[]
  conversations    Conversation[]

  @@index([ownerId, status])
  @@index([status, createdAt])
  @@index([status, price])
  @@index([status, bedrooms, bathrooms])
  @@index([status, rentalMode, furnishedStatus, availability])
  @@index([propertyType, status])
  @@index([rentalMode, status])
  @@index([price])
  @@index([propertyType])
  @@index([city, area])
  @@index([locationId])
  @@index([latitude, longitude])
}

model PropertyManager {
  id         String   @id @default(cuid())
  propertyId String
  userId     String
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([propertyId, userId])
  @@index([userId])
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String?
  listingId  String?
  url        String
  publicId   String?
  altText    String?
  sortOrder  Int      @default(0)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  property Property? @relation("PropertyImageProperty", fields: [propertyId], references: [id], onDelete: Cascade)
  listing  Listing?  @relation("ListingImage", fields: [listingId], references: [id], onDelete: Cascade)

  @@index([propertyId, sortOrder])
  @@index([listingId, sortOrder])
}

model Amenity {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  listings PropertyAmenity[]
}

model PropertyAmenity {
  id         String  @id @default(cuid())
  propertyId String?
  listingId  String?
  amenityId  String

  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  listing  Listing?  @relation("ListingAmenity", fields: [listingId], references: [id], onDelete: Cascade)
  amenity  Amenity   @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([propertyId, amenityId])
  @@unique([listingId, amenityId])
  @@index([propertyId])
  @@index([listingId])
  @@index([amenityId])
}

model Listing {
  id                String                   @id @default(cuid())
  propertyId        String?
  title             String
  description       String
  rules             String?
  area              String
  city              String
  address           String
  type              PropertyType
  bedrooms          Int
  bathrooms         Int
  unitCount         Int                      @default(1)
  roomCount         Int                      @default(0)
  sqft              Int
  rent              Int
  deposit           Int?
  rentalDuration    RentalDuration           @default(MONTHLY)
  listingMode       ListingMode              @default(LONG_TERM)
  availableFrom     DateTime?
  latitude          Float?
  longitude         Float?
  status            ListingStatus            @default(PENDING)
  publicationStatus ListingPublicationStatus @default(PUBLISHED)
  availability      ListingAvailability      @default(AVAILABLE)
  furnishedStatus   FurnishedStatus          @default(UNFURNISHED)
  fraudScore        Float                    @default(0)
  photos            String[]
  landlordId        String
  locationId        String?
  isFeatured        Boolean                  @default(false)
  isInstantBookable Boolean                  @default(false)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  property         Property?         @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  landlord         User              @relation(fields: [landlordId], references: [id], onDelete: Cascade)
  location         Location?         @relation("ListingLocation", fields: [locationId], references: [id], onDelete: SetNull)
  images           PropertyImage[]   @relation("ListingImage")
  amenities        PropertyAmenity[] @relation("ListingAmenity")
  hostelDetails    HostelDetails?
  hostelRooms      HostelRoom[]
  favorites        Favorite[]        @relation("FavoriteListing")
  rentalRequests   RentalRequest[]
  agreements       Agreement[]
  reviews          Review[]          @relation("ReviewListing")
  reports          Report[]          @relation("ReportListing")
  propertyViews    PropertyView[]    @relation("PropertyViewListing")
  conversations    Conversation[]    @relation("ConversationListing")
  bookings         Booking[]
  availabilityData Availability[]

  @@index([city])
  @@index([area])
  @@index([type])
  @@index([status])
  @@index([rent])
  @@index([bedrooms])
  @@index([roomCount])
  @@index([landlordId])
  @@index([locationId])
  @@index([latitude, longitude])
}

model Hotel {
  id           String   @id @default(cuid())
  propertyId   String   @unique
  starRating   Int?
  checkInTime  String?
  checkOutTime String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  property  Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomTypes RoomType[]
  rooms     HotelRoom[]
}

model RoomType {
  id            String   @id @default(cuid())
  hotelId       String
  name          String
  capacity      Int
  price         Int
  amenities     String[]
  numberOfRooms Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  hotel Hotel       @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  rooms HotelRoom[]

  @@unique([hotelId, name])
  @@index([hotelId])
}

model HotelRoom {
  id          String   @id @default(cuid())
  hotelId     String
  roomNumber  String
  roomTypeId  String?
  capacity    Int
  basePrice   Int?
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hotel        Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomType     RoomType?      @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)
  bookings     Booking[]
  availability Availability[]

  @@unique([hotelId, roomNumber])
  @@index([hotelId])
  @@index([roomTypeId])
}

model Hostel {
  id           String   @id @default(cuid())
  propertyId   String   @unique
  genderPolicy String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  property Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rooms    HostelRoom[]
}

model HostelDetails {
  id                  String             @id @default(cuid())
  listingId           String             @unique
  buildingName        String
  genderPolicy        HostelGenderPolicy
  bedCapacity         Int
  availableBeds       Int
  messIncluded        Boolean            @default(false)
  wifiIncluded        Boolean            @default(false)
  laundryIncluded     Boolean            @default(false)
  electricityIncluded Boolean            @default(false)
  securityIncluded    Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model HostelRoom {
  id            String   @id @default(cuid())
  listingId     String
  hostelId      String?
  roomNumber    String
  capacity      Int
  availableBeds Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  listing      Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  hostel       Hostel?        @relation(fields: [hostelId], references: [id], onDelete: SetNull)
  beds         HostelBed[]
  availability Availability[]

  @@unique([listingId, roomNumber])
  @@index([listingId])
}

model HostelBed {
  id           String   @id @default(cuid())
  hostelRoomId String
  bedNumber    String
  isAvailable  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  room         HostelRoom     @relation(fields: [hostelRoomId], references: [id], onDelete: Cascade)
  bookings     Booking[]
  availability Availability[]

  @@unique([hostelRoomId, bedNumber])
  @@index([hostelRoomId])
}

model Availability {
  id            String             @id @default(cuid())
  propertyId    String?
  listingId     String?
  hotelRoomId   String?
  hostelRoomId  String?
  hostelBedId   String?
  date          DateTime
  status        AvailabilityStatus @default(AVAILABLE)
  holdUntil     DateTime?
  blockedReason String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  property   Property?   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  listing    Listing?    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  hotelRoom  HotelRoom?  @relation(fields: [hotelRoomId], references: [id], onDelete: Cascade)
  hostelRoom HostelRoom? @relation(fields: [hostelRoomId], references: [id], onDelete: Cascade)
  hostelBed  HostelBed?  @relation(fields: [hostelBedId], references: [id], onDelete: Cascade)

  @@unique([propertyId, listingId, hotelRoomId, hostelRoomId, hostelBedId, date])
  @@index([date, status])
  @@index([listingId, date])
  @@index([hotelRoomId, date])
  @@index([hostelBedId, date])
}

model Booking {
  id            String        @id @default(cuid())
  tenantId      String
  propertyId    String?
  listingId     String?
  hotelRoomId   String?
  hostelBedId   String?
  startDate     DateTime
  endDate       DateTime
  guests        Int           @default(1)
  totalAmount   Int
  currency      String        @default("PKR")
  status        BookingStatus @default(PENDING)
  holdExpiresAt DateTime?
  confirmedAt   DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant        User           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property      Property?      @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  listing       Listing?       @relation(fields: [listingId], references: [id], onDelete: SetNull)
  hotelRoom     HotelRoom?     @relation(fields: [hotelRoomId], references: [id], onDelete: SetNull)
  hostelBed     HostelBed?     @relation(fields: [hostelBedId], references: [id], onDelete: SetNull)
  payments      Payment[]
  reviews       Review[]       @relation("ReviewBooking")
  disputes      Dispute[]
  conversations Conversation[] @relation("BookingConversations")

  @@index([tenantId, status])
  @@index([status, startDate, endDate])
  @@index([propertyId, status])
  @@index([hotelRoomId, status])
  @@index([hostelBedId, status])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  listingId  String?
  propertyId String?
  createdAt  DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing  Listing?  @relation("FavoriteListing", fields: [listingId], references: [id], onDelete: Cascade)
  property Property? @relation("FavoriteProperty", fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@unique([userId, propertyId])
  @@index([listingId])
  @@index([propertyId])
}

model RentalRequest {
  id             String              @id @default(cuid())
  listingId      String?
  propertyId     String?
  tenantId       String
  landlordId     String
  moveInDate     DateTime?
  durationMonths Int?
  occupants      Int                 @default(1)
  message        String?
  status         RentalRequestStatus @default(PENDING)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  listing    Listing?    @relation(fields: [listingId], references: [id], onDelete: SetNull)
  property   Property?   @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  tenant     User        @relation("RequestTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  landlord   User        @relation("RequestLandlord", fields: [landlordId], references: [id], onDelete: Cascade)
  agreements Agreement[] @relation("AgreementRequest")
  payments   Payment[]

  @@unique([listingId, tenantId])
  @@index([landlordId, status])
  @@index([tenantId, status])
  @@index([propertyId, status])
  @@index([listingId, status])
}

model Agreement {
  id              String          @id @default(cuid())
  listingId       String
  propertyId      String?
  tenantId        String
  landlordId      String
  rentalRequestId String?
  rent            Int
  deposit         Int?
  startDate       DateTime
  endDate         DateTime?
  pdfUrl          String?
  status          AgreementStatus @default(PENDING)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  listing       Listing?       @relation(fields: [listingId], references: [id], onDelete: Restrict)
  property      Property?      @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  tenant        User           @relation("TenantAgreements", fields: [tenantId], references: [id], onDelete: Cascade)
  landlord      User           @relation("LandlordAgreements", fields: [landlordId], references: [id], onDelete: Cascade)
  rentalRequest RentalRequest? @relation("AgreementRequest", fields: [rentalRequestId], references: [id], onDelete: SetNull)
  payments      Payment[]
  disputes      Dispute[]
  reviews       Review[]       @relation("ReviewAgreement")

  @@index([tenantId, status])
  @@index([landlordId, status])
  @@index([propertyId, status])
}

model Payment {
  id              String        @id @default(cuid())
  bookingId       String?
  rentalRequestId String?
  agreementId     String?
  tenantId        String
  amount          Int
  currency        String        @default("PKR")
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  transactionId   String?
  receiptUrl      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  booking       Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  rentalRequest RentalRequest? @relation(fields: [rentalRequestId], references: [id], onDelete: SetNull)
  agreement     Agreement?     @relation(fields: [agreementId], references: [id], onDelete: SetNull)
  tenant        User           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([agreementId, status])
  @@index([bookingId, status])
}

model Review {
  id          String            @id @default(cuid())
  userId      String
  listingId   String?
  propertyId  String?
  bookingId   String?
  agreementId String?
  rating      Int
  comment     String?
  targetType  ReviewTargetType?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing?   @relation("ReviewListing", fields: [listingId], references: [id], onDelete: SetNull)
  property  Property?  @relation("ReviewProperty", fields: [propertyId], references: [id], onDelete: SetNull)
  booking   Booking?   @relation("ReviewBooking", fields: [bookingId], references: [id], onDelete: SetNull)
  agreement Agreement? @relation("ReviewAgreement", fields: [agreementId], references: [id], onDelete: SetNull)

  @@unique([listingId, userId])
  @@unique([propertyId, userId])
  @@index([listingId, createdAt])
  @@index([propertyId, createdAt])
}

model TrustScore {
  id        String      @id @default(cuid())
  userId    String
  score     Int
  source    TrustSource
  reason    String?
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Report {
  id          String           @id @default(cuid())
  reporterId  String
  targetType  ReportTargetType
  targetId    String
  propertyId  String?
  listingId   String?
  messageId   String?
  reason      String
  description String?
  status      ReportStatus     @default(OPEN)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  reporter User      @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  property Property? @relation("ReportProperty", fields: [propertyId], references: [id], onDelete: SetNull)
  listing  Listing?  @relation("ReportListing", fields: [listingId], references: [id], onDelete: SetNull)
  message  Message?  @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([listingId])
  @@index([messageId])
}

model Dispute {
  id          String        @id @default(cuid())
  propertyId  String?
  bookingId   String?
  agreementId String?
  tenantId    String
  title       String
  description String
  amount      Int?
  status      DisputeStatus @default(OPEN)
  resolution  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  property  Property?  @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  booking   Booking?   @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  agreement Agreement? @relation(fields: [agreementId], references: [id], onDelete: SetNull)
  tenant    User       @relation("TenantDisputes", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model Conversation {
  id             String   @id @default(cuid())
  participant1Id String
  participant2Id String
  listingId      String?
  propertyId     String?
  bookingId      String?
  lastMessageAt  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  participant1 User      @relation("User1", fields: [participant1Id], references: [id], onDelete: Cascade)
  participant2 User      @relation("User2", fields: [participant2Id], references: [id], onDelete: Cascade)
  listing      Listing?  @relation("ConversationListing", fields: [listingId], references: [id], onDelete: SetNull)
  property     Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  booking      Booking?  @relation("BookingConversations", fields: [bookingId], references: [id], onDelete: SetNull)
  messages     Message[]

  @@unique([participant1Id, participant2Id, listingId])
  @@index([participant1Id, participant2Id])
  @@index([listingId])
  @@index([propertyId])
  @@index([bookingId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  attachmentUrl  String?
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)
  reports      Report[]

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model SavedSearch {
  id          String   @id @default(cuid())
  userId      String
  name        String
  filtersJson Json
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ContactMessage {
  id        String               @id @default(cuid())
  name      String
  email     String
  phone     String
  message   String
  status    ContactMessageStatus @default(NEW)
  read      Boolean              @default(false)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

model AdminAction {
  id         String          @id @default(cuid())
  adminId    String
  actionType AdminActionType
  targetType String
  targetId   String
  reason     String?
  createdAt  DateTime        @default(now())

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, createdAt])
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([email, token])
}

model ResetPasswordToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([email, token])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PropertyView {
  id         String   @id @default(cuid())
  propertyId String?
  listingId  String?
  userId     String?
  sessionId  String?
  viewedAt   DateTime @default(now())

  property Property? @relation("PropertyViewProperty", fields: [propertyId], references: [id], onDelete: Cascade)
  listing  Listing?  @relation("PropertyViewListing", fields: [listingId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([listingId, viewedAt])
  @@index([propertyId, viewedAt])
  @@index([userId, viewedAt])
  @@index([sessionId, viewedAt])
}
